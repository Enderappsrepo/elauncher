{
  // The NVMP Companion. One project for main, preload and renderer: main runs the panel's
  // nvmpTransfer.ts on Node File/Blob objects, so it needs the DOM types as much as the window does.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "useDefineForClassFields": true,
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@web/*": ["./web/src/*"],
      "@companion/*": ["./companion/*"]
    }
  },
  "include": ["electron.vite.companion.config.ts", "companion/**/*", "src/shared/**/*", "web/src/panel/nvmpTransfer.ts"]
}
