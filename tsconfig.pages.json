{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    // vite/client declares the side-effect CSS imports and import.meta.env
    "types": ["vite/client"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@web/*": ["./web/src/*"]
    }
  },
  "include": ["web/**/*", "src/shared/**/*"]
}
