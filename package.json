{
  "name": "elauncher",
  "version": "0.1.1",
  "description": "A custom Minecraft launcher with Microsoft login, mod loaders, mods, and shareable modpacks",
  "main": "./out/main/index.js",
  "author": "ELauncher",
  "license": "MIT",
  "private": true,
  "overrides": {
    "@xmcl/installer": {
      "undici": "^6.21.3"
    }
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "icon": "node scripts/make-ico.mjs",
    "docs": "node scripts/serve-docs.mjs",
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "dist": "electron-vite build && electron-builder --win",
    "release": "electron-vite build && electron-builder --win --publish always",
    "version": "node scripts/sync-tokens.mjs && git add docs/"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jimp": "^1.6.1",
    "png-to-ico": "^3.0.2",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@supabase/supabase-js": "^2.110.5",
    "@xmcl/core": "^2.15.1",
    "@xmcl/installer": "^6.1.2",
    "@xmcl/nbt": "^3.0.2",
    "adm-zip": "^0.6.0",
    "electron-updater": "^6.8.9",
    "msmc": "^5.0.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "skinview3d": "^3.4.2",
    "undici": "^6.27.0",
    "web-push": "^3.6.7"
  }
}
