# ELauncher Discord bot — environment for discord-bot.service.
# Copy to /etc/elauncher/discord-bot.env and fill the three empty values.
# chmod 600 it: the bot token and service key are full credentials.

# From your Discord application (discord.com/developers/applications):
#   Bot tab -> Token (Reset Token if hidden)
DISCORD_BOT_TOKEN=
#   General Information -> Application ID
DISCORD_APP_ID=

# The Supabase project the panel and launcher already use:
SUPABASE_URL=https://noodzwrbsibogeoukvye.supabase.co
SUPABASE_ANON_KEY=sb_publishable_DgVhX7zDLdO2ghE14jcrTw_o3yLxwrs
#   Dashboard -> Project Settings -> API keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# DISCORD_PUBLIC_KEY is deliberately absent: the shim mints its own signing
# keypair each boot and hands the public half to the function. The value in
# the Discord portal only matters for the Supabase-hosted endpoint.
